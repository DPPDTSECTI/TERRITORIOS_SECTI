# ==============================================================================
# CONECTA BAHIA - EXEMPLO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas configurações locais:
#   cp .env.example .env
#
# AVISO: Nunca altere ou adicione segredos/credenciais reais neste arquivo.
# ==============================================================================

# 1. SharePoint (Obrigatório para sincronização de dados)
# URL de download direto da planilha oficial no SharePoint Microsoft 365.
VITE_SHAREPOINT_URL="https://prodeboffice365-my.sharepoint.com/:x:/g/personal/sdc_secti_ba_gov_br/exemplo_placeholder?download=1"

# 2. Upstash Redis (Obrigatório para teste local das rotas Vercel Serverless / Cache)
# URL e Token REST fornecidos pelo Upstash Redis no Vercel Marketplace
# (Também compatível com as chaves KV_REST_API_URL e KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="exemplo_token_secreto_rest_upstash"

# 3. OpenRouter API Key (Opcional)
# Chave da API OpenRouter para habilitar funcionalidades do assistente de IA.
# Deixe vazio caso não necessite testar os recursos de IA localmente.
VITE_OPENROUTER_API_KEY=""
